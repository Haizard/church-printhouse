
{
  "entities": {
    "Sermon": {
      "title": "Sermon",
      "description": "A recording or transcript of a church teaching.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "speaker": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "topic": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "videoUrl": { "type": "string" }
      },
      "required": ["title", "speaker", "date", "topic"]
    },
    "Event": {
      "title": "Event",
      "description": "A community gathering or church activity.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "date", "time"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A reflection or news update from the church community.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["title", "author", "date", "content"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "An image showcasing church life.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["title", "imageUrl", "category"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "A message submitted via the contact form.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "email", "message"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/sermons/{sermonId}": {
      "schema": { "$ref": "#/entities/Sermon" },
      "description": "Collection of sermon records."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Collection of upcoming and past events."
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Collection of community blog posts."
    },
    "/gallery/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Collection of gallery images."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Collection of contact form submissions."
    }
  }
}
