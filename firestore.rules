rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}